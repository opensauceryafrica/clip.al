# ============================================================================
# clip.al — environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in. This single file feeds BOTH docker-compose
# (infra credentials) AND the application (validated at boot by packages/config).
# Where a value appears in two forms (e.g. POSTGRES_* and DATABASE_URL) they
# MUST agree. Never commit a filled-in .env — only this .example file.
# ============================================================================

# ---- App --------------------------------------------------------------------
NODE_ENV=production
# Public origin. Used for absolute URLs, same-origin CSRF checks, email links.
APP_URL=https://clip.al
# Port the Next.js server and worker health endpoint bind to (behind Caddy).
PORT=3000
# 64 random bytes, hex. Signs the session JWT (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=
# Cookie scope. Set to the apex so sessions work across *.clip.al subdomains.
COOKIE_DOMAIN=clip.al

# ---- Postgres ---------------------------------------------------------------
# Discrete creds consumed by the postgres container in docker-compose.
POSTGRES_USER=clipal
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=clipal
# Connection string consumed by the app/worker. Host is the compose service
# name on the internal network. MUST match the three values above.
DATABASE_URL=postgres://clipal:CHANGEME@postgres:5432/clipal

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---- ClickHouse -------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
# Leave blank for the default user in dev; set a real password in prod.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=clipal

# ---- MinIO (S3-compatible object storage) -----------------------------------
# Root creds consumed by the minio container.
MINIO_ROOT_USER=clipal
MINIO_ROOT_PASSWORD=CHANGEME
# App-facing S3 config. S3_ACCESS_KEY/S3_SECRET_KEY normally equal the root
# creds in single-tenant deploys (or a scoped service account you create).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=clipal
S3_ACCESS_KEY=clipal
S3_SECRET_KEY=CHANGEME
# Public CDN origin that fronts the bucket (Caddy/edge). Used to build asset URLs.
S3_PUBLIC_URL=https://cdn.clip.al

# ---- Resend (transactional email — the ONLY external SaaS in Phase 1) -------
RESEND_API_KEY=
EMAIL_FROM="clip.al <no-reply@clip.al>"
# DEV ONLY — when email delivery FAILS, log the 6-digit auth code to stderr
# (grep it from `docker compose ... logs web`). Lets you test sign-in with any
# email locally without a verified Resend domain. NEVER enable in production:
# it writes login codes to logs. (No effect when delivery succeeds — real prod
# with a verified domain emails normally and never logs codes.)
AUTH_DEV_LOG_CODES_ON_FAIL=false

# ---- Cloudflare Turnstile (CAPTCHA) -----------------------------------------
# Free widget. Site key is public (sent to browser); secret key is server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Google Safe Browsing (URL safety) --------------------------------------
# Free API key from Google Cloud console (Safe Browsing API v4 enabled).
GSB_API_KEY=

# ---- GlitchTip / Sentry-compatible error tracking (optional) ----------------
# Leave blank to disable. See infra/docker-compose.observability.yml.
SENTRY_DSN=

# ---- Rate limits (override the in-code defaults) ----------------------------
RATE_LIMIT_ANON_SHORTEN_PER_HOUR=10
RATE_LIMIT_ANON_SHORTEN_PER_DAY=50
RATE_LIMIT_AUTHED_SHORTEN_PER_HOUR=200
RATE_LIMIT_AUTHED_SHORTEN_PER_DAY=2000
RATE_LIMIT_AUTH_CODE_PER_HOUR=5
RATE_LIMIT_AUTH_CODE_PER_IP_PER_HOUR=10
RATE_LIMIT_VERIFY_PER_HOUR=10

# ---- Worker: MaxMind GeoLite2 -----------------------------------------------
# Directory (mounted into the worker container) holding GeoLite2-City.mmdb and
# GeoLite2-Country.mmdb. The worker refreshes these monthly. Geo is best-effort:
# if the files are absent the worker still ingests clicks with country="ZZ".
GEOIP_DIR=/data/geoip
# MaxMind license key for the monthly GeoLite2 auto-refresh. NOT in the prompt's
# env list, but GeoLite2 downloads require it (TODO(@owner), see OPEN_QUESTIONS).
# Leave blank to disable auto-refresh and supply the .mmdb files manually.
MAXMIND_LICENSE_KEY=
# Port the worker's liveness HTTP endpoint binds to (docker healthcheck).
WORKER_HEALTH_PORT=9090

# ---- Admin bootstrap (scripts/seed-admin.ts) --------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Owner

# ---- Migration (Phase 1 one-shot, scripts/migrate-abbrefy.ts) ---------------
ABBREFY_EXPORT_PATH=/data/abbrefy-export.json
